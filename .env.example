# Application
APP_NAME="Enterprise Document Intelligence"
ENVIRONMENT=development
DEBUG=false

# Database (use PostgreSQL in production)
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/enterprise_docs

# Security - CHANGE IN PRODUCTION
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Cloud Platform
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=models/embedding-001

# Google Cloud Storage
GCS_BUCKET_NAME=enterprise-documents

# Pub/Sub
PUBSUB_TOPIC=document-processing
PUBSUB_SUBSCRIPTION=document-processing-sub

# BigQuery
BIGQUERY_DATASET=document_intelligence
BIGQUERY_LOCATION=US

# Redis
REDIS_URL=redis://localhost:6379/0

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=documents

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# CORS
ALLOWED_ORIGINS=["http://localhost:8501","http://localhost:3000"]

# OCR
TESSERACT_CMD=/usr/bin/tesseract
PDF_DPI=300
